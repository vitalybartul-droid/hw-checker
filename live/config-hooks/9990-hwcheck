#!/bin/sh
# live-config hook: runs as root at boot; the kernel line has
# "hooks=file:///run/live/medium/live/config-hooks/9990-hwcheck" (added by tools/build-iso.sh).
# Installs hwcheck and makes it start automatically on tty1 after autologin.

M=/run/live/medium/hwcheck

# Keep kernel warnings from printing over the report on the console
dmesg -n 1 2>/dev/null

# Add the extra tools from hwcheck/debs/ (mc, ntfs-3g, chntpw, ...).
# We just unpack the files into the live filesystem instead of "dpkg -i":
# no dpkg database, no maintainer scripts, no triggers - boots seconds faster.
if ls "$M"/debs/*.deb >/dev/null 2>&1; then
  for f in "$M"/debs/*.deb; do dpkg-deb -x "$f" / 2>/dev/null; done
  ldconfig 2>/dev/null                       # refresh the shared-library cache once
fi

# Copy the scripts into RAM, fixing Windows line endings if an editor added them
mkdir -p /usr/local/lib/hwcheck
for f in "$M"/*.sh; do
  tr -d '\r' < "$f" > "/usr/local/lib/hwcheck/$(basename "$f")"
done
chmod 755 /usr/local/lib/hwcheck/*.sh
ln -sf /usr/local/lib/hwcheck/hwcheck.sh /usr/local/bin/hwcheck

cat > /etc/profile.d/zz-hwcheck.sh <<'EOF'
if [ "$(tty)" = /dev/tty1 ] && [ ! -e /tmp/.hwcheck_done ]; then
  touch /tmp/.hwcheck_done
  sudo /usr/local/bin/hwcheck
fi
EOF
